new file mode 100644
index 000000000000..a54f505fa832
--- /dev/null
+++ b/include/linux/susfs_selinux.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SUSFS_SELINUX_H
+#define _LINUX_SUSFS_SELINUX_H
+
+#include <linux/types.h>
+
+/* Interface revision; this is not a SUSFS feature or version claim. */
+#define SUSFS_SELINUX_ADAPTER_ABI 1
+
+struct av_decision;
+struct page;
+
+#ifdef CONFIG_KSU_SUSFS
+#ifndef CONFIG_KSU
+#error "The devon SELinux adapter requires built-in KernelSU"
+#endif
+/*
+ * These operations may sleep. The caller performs the live-policy permission
+ * checks before calling. False means use the ordinary SELinux operation; true
+ * means handled, including errors in *error. An active adapter never falls back
+ * after a policy error. No policydb, sidtab or saved-policy SID escapes here.
+ */
+bool ksu_susfs_set_current_sid(const char *context, u32 len, u32 *sid,
+			      int *error);
+/* On success, *canon is allocated with kmalloc and the caller must kfree it. */
+bool ksu_susfs_context_to_string(const char *context, u32 len, char **canon,
+			       u32 *canon_len, int *error);
+bool ksu_susfs_compute_av(const char *source, const char *target, u16 tclass,
+			 struct av_decision *avd, int *error);
+/* Returns one owned page reference, or NULL to use the real status page. */
+struct page *ksu_susfs_get_status_page(void);
+#endif
+
+#endif /* _LINUX_SUSFS_SELINUX_H */

+#ifdef KSU_COMPAT_DEVON_SELINUX_POLICY
+/* Protected by selinux_hide_mutex, including after the backup is dropped. */
+static bool ksu_devon_stock_captured;
+
+struct ksu_devon_policy_tx {
+    struct policydb *pair;
+    struct policydb *live;
+    struct policydb *saved;
+    struct sidtab *saved_sidtab;
+    struct selinux_fs_info *fsi;
+    bool cloned;
+    bool saved_cloned;
+    bool saved_sids_ready;
+};
+
+/* End owns every private allocation; failed parsers already destroy internals. */
+static void ksu_devon_policy_end(struct ksu_devon_policy_tx *tx, bool install)
+{
+    if (install) {
+        write_lock_irq(&selinux_state.ss->policy_rwlock);
+        memcpy(tx->pair, tx->live, sizeof(*tx->live));
+        memcpy(tx->live, tx->pair + 1, sizeof(*tx->live));
+        write_unlock_irq(&selinux_state.ss->policy_rwlock);
+        tx->cloned = false; /* The live state owns the replacement internals. */
+        if (tx->saved_sids_ready) {
+            backup_policydb = tx->saved;
+            backup_sidtab = tx->saved_sidtab;
+            tx->saved = NULL;
+            tx->saved_sidtab = NULL;
+            tx->saved_cloned = false;
+            tx->saved_sids_ready = false;
+            ksu_devon_stock_captured = true;
+        }
+        reset_avc_cache();
+        ksu_destroy_policydb(tx->pair);
+    } else if (tx->cloned) {
+        ksu_destroy_policydb(tx->pair + 1);
+    }
+    if (tx->saved_sids_ready)
+        sidtab_destroy(tx->saved_sidtab);
+    if (tx->saved_cloned)
+        ksu_destroy_policydb(tx->saved);
+    kfree(tx->saved_sidtab);
+    kfree(tx->saved);
+    kfree(tx->pair);
+    mutex_unlock(&tx->fsi->mutex);
+    ksu_selinux_hide_unlock();
+}
+
+static int ksu_devon_policy_begin(struct ksu_devon_policy_tx *tx, bool initial)
+{
+    int ret = -EAGAIN;
+
+    memset(tx, 0, sizeof(*tx));
+    /* Order: hide mutex -> selinuxfs mutex -> policy rwlock. */
+    ksu_selinux_hide_lock();
+    if (!selinux_state.ss || !selinux_initialized(&selinux_state) ||
+        !selinuxfs_mount || IS_ERR(selinuxfs_mount) ||
+        !selinuxfs_mount->mnt_sb || !selinuxfs_mount->mnt_sb->s_fs_info)
+        goto out_hide;
+    if (!initial && !ksu_devon_stock_captured)
+        goto out_hide;
+
+    tx->fsi = selinuxfs_mount->mnt_sb->s_fs_info;
+    mutex_lock(&tx->fsi->mutex);
+    tx->live = &selinux_state.ss->policydb;
+    tx->pair = kcalloc(2, sizeof(*tx->pair), GFP_KERNEL);
+    if (!tx->pair) {
+        ret = -ENOMEM;
+        goto out_tx;
+    }
+    ret = ksu_dup_policydb(tx->live, tx->pair + 1);
+    if (ret < 0)
+        goto out_tx;
+    tx->cloned = true;
+    return 0;
+
+out_tx:
+    ksu_devon_policy_end(tx, false);
+    return ret;
+out_hide:
+    ksu_selinux_hide_unlock();
+    return ret;
+}
+
+static int ksu_devon_prepare_backup(struct ksu_devon_policy_tx *tx)
+{
+    int ret;
+
+    /* Never overwrite the first snapshot or recreate one from modified policy. */
+    if (ksu_devon_stock_captured)
+        return 0;
+    if (backup_policydb || backup_sidtab)
+        return -EUCLEAN;
+    tx->saved = kzalloc(sizeof(*tx->saved), GFP_KERNEL);
+    if (!tx->saved)
+        return -ENOMEM;
+    ret = ksu_dup_policydb(tx->live, tx->saved);
+    if (ret < 0)
+        return ret;
+    tx->saved_cloned = true;
+    tx->saved_sidtab = kzalloc(sizeof(*tx->saved_sidtab), GFP_KERNEL);
+    if (!tx->saved_sidtab)
+        return -ENOMEM;
+    ret = policydb_load_isids(tx->saved, tx->saved_sidtab);
+    if (ret)
+        return ret;
+    tx->saved_sids_ready = true;
+    return 0;
+}
+
+int apply_kernelsu_rules(void)
+{
+    struct ksu_devon_policy_tx tx;
+    int ret;
+
+    ret = ksu_devon_policy_begin(&tx, true);
+    if (ret)
+        return ret;
+    ret = ksu_devon_prepare_backup(&tx);
+    if (ret) {
+        ksu_devon_policy_end(&tx, false);
+        return ret;
+    }
+    if (!ksu_apply_default_rules(tx.pair + 1)) {
+        ksu_devon_policy_end(&tx, false);
+        return -EINVAL;
+    }
+    ksu_devon_policy_end(&tx, true);
+    return 0;
+}

+int setup_ksu_cred(void)
+{
+    int ret;
+
+    /* Published credentials stay immutable after their first successful setup. */
+    mutex_lock(&ksu_devon_cred_mutex);
+    if (ksu_susfs_cred_ready()) {
+        ret = 0;

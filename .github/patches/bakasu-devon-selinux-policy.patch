+#ifdef KSU_COMPAT_DEVON_SELINUX_POLICY
+/* Devon uses held-file inline hooks; published f_op/private_data stay native. */
+static bool is_init_rc(struct file *file);
+struct ksu_devon_rc_view {
+    struct list_head node;
+    struct file *file; /* Borrowed until the final __fput cleanup hook. */
+    loff_t base;
+    loff_t total;
+    const char *tail;
+    size_t tail_len;
+};
+static LIST_HEAD(ksu_devon_rc_views);
+static DEFINE_MUTEX(ksu_devon_rc_lock);
+static DEFINE_MUTEX(ksu_devon_rc_cache_lock);
+static char *ksu_devon_rc_tail;
+static size_t ksu_devon_rc_tail_len;
+static bool ksu_devon_rc_loaded;
+const size_t ksu_rc_len = sizeof(KERNEL_SU_RC) - 1;
+
+static bool ksu_devon_rc_owner(struct file *file)
+{
+    return file && file_count(file) > 0 && current->pid == 1 && current_uid().val == 0 &&
+           ksu_susfs_cred_ready() && is_init(current_cred()) &&
+           (file->f_mode & (FMODE_READ | FMODE_CAN_READ | FMODE_OPENED | FMODE_WRITE | FMODE_STREAM)) ==
+               (FMODE_READ | FMODE_CAN_READ | FMODE_OPENED) && !(file->f_flags & O_DIRECT);
+}
+
+static struct ksu_devon_rc_view *ksu_devon_rc_find(struct file *file)
+{
+    struct ksu_devon_rc_view *view;
+
+    list_for_each_entry(view, &ksu_devon_rc_views, node)
+        if (view->file == file)
+            return view;
+    return NULL;
+}
+
+/* Called with the install lock; failed loads remain retryable. */
+static int ksu_devon_rc_load(void)
+{
+    const struct cred *saved;
+    struct file *file;
+    char *module = NULL, *tail;
+    loff_t size, pos = 0;
+    size_t module_len = 0, total;
+    ssize_t got;
+    int ret = 0, first_error;
+
+    if (ksu_devon_rc_loaded)
+        return 0;
+    if (ksu_no_custom_rc)
+        goto make_tail;
+    saved = override_creds(ksu_cred);
+    file = filp_open("/metadata/watchdog/ksu/modules.rc", O_RDONLY | O_NONBLOCK, 0);
+    first_error = IS_ERR(file) ? PTR_ERR(file) : 0;
+    if (IS_ERR(file))
+        file = filp_open("/metadata/ksu/modules.rc", O_RDONLY | O_NONBLOCK, 0);
+    if (IS_ERR(file)) {
+        ret = PTR_ERR(file);
+        if ((ret == -ENOENT || ret == -ENOTDIR) &&
+            (first_error == -ENOENT || first_error == -ENOTDIR))
+            ret = 0;
+        else if (ret == -ENOENT || ret == -ENOTDIR)
+            ret = first_error;
+        goto revert;
+    }
+    if (!S_ISREG(file_inode(file)->i_mode)) {
+        ret = -EINVAL;
+        goto close;
+    }
+    size = i_size_read(file_inode(file));
+    if (size < 0 || size > SZ_1M) {
+        ret = size < 0 ? -EINVAL : -EFBIG;
+        goto close;
+    }
+    if (size) {
+        module = vmalloc(size);
+        if (!module) {
+            ret = -ENOMEM;
+            goto close;
+        }
+        while (pos < size) {
+            loff_t before = pos;
+
+            got = ksu_kernel_read_compat(file, module + pos, size - pos, &pos);
+            if (got <= 0 || got > size - before || pos != before + got) {
+                ret = got < 0 ? got : -EIO;
+                goto close;
+            }
+        }
+        module_len = size;
+    }
+close:
+    filp_close(file, NULL);
+revert:
+    revert_creds(saved);
+    if (ret)
+        goto out;
+make_tail:
+    total = ksu_rc_len + module_len; /* Both terms are bounded. */
+    tail = vmalloc(total);
+    if (!tail) {
+        ret = -ENOMEM;
+        goto out;
+    }
+    memcpy(tail, KERNEL_SU_RC, ksu_rc_len);
+    if (module_len)
+        memcpy(tail + ksu_rc_len, module, module_len);
+    /* Immutable boot cache; target Kconfig requires built-in KSU. */
+    ksu_devon_rc_tail = tail;
+    ksu_devon_rc_tail_len = total;
+    ksu_devon_rc_loaded = true;
+out:
+    vfree(module);
+    return ret;
+}
+
+/* Returned state is borrowed while the caller keeps its native file reference. */
+static int ksu_devon_rc_get(struct file *file, loff_t base,
+                            struct ksu_devon_rc_view **result)
+{
+    struct ksu_devon_rc_view *view, *candidate;
+    int ret;
+
+    *result = NULL;
+    if (!ksu_devon_rc_owner(file))
+        return 0;
+    mutex_lock(&ksu_devon_rc_lock);
+    view = ksu_devon_rc_find(file);
+    if (view) {
+        ret = i_size_read(file_inode(file)) != view->base ? -ESTALE : 0;
+        if (!ret)
+            *result = view;
+        mutex_unlock(&ksu_devon_rc_lock);
+        return ret;
+    }
+    mutex_unlock(&ksu_devon_rc_lock);
+    /* The captured view follows the open file, including pathname renames. */
+    if (ksu_init_rc_hook_inactive() || !is_init_rc(file))
+        return 0;
+    if (base < 0)
+        return -EOVERFLOW;
+
+    /* Keep filesystem I/O outside the view/close lock. */
+    mutex_lock(&ksu_devon_rc_cache_lock);
+    ret = ksu_devon_rc_load();
+    mutex_unlock(&ksu_devon_rc_cache_lock);
+    if (ret)
+        return ret;
+    if (base > LLONG_MAX - (loff_t)ksu_devon_rc_tail_len)
+        return -EOVERFLOW;
+    candidate = kzalloc(sizeof(*candidate), GFP_KERNEL);
+    if (!candidate)
+        return -ENOMEM;
+    candidate->file = file;
+    candidate->base = base;
+    candidate->total = base + ksu_devon_rc_tail_len;
+    candidate->tail = ksu_devon_rc_tail;
+    candidate->tail_len = ksu_devon_rc_tail_len;
+
+    mutex_lock(&ksu_devon_rc_lock);
+    view = ksu_devon_rc_find(file);
+    if (view) {
+        ret = i_size_read(file_inode(file)) != view->base ? -ESTALE : 0;
+        if (!ret)
+            *result = view;
+        kfree(candidate);
+    } else {
+        list_add(&candidate->node, &ksu_devon_rc_views);
+        *result = candidate;
+        ret = 0;
+    }
+    mutex_unlock(&ksu_devon_rc_lock);
+    return ret;
+}
+
+int ksu_handle_vfs_fstat_file(struct file *file, loff_t *size)
+{
+    struct ksu_devon_rc_view *view;
+    int ret = ksu_devon_rc_get(file, *size, &view);
+
+    if (!ret && view)
+        *size = view->total;
+    return ret;
+}
+
+/* 0: native prefix read; 1: logical tail/EOF handled; negative: real error. */
+int ksu_handle_sys_read_file(struct file *file, char __user *buf, size_t *count,
+                             loff_t *pos, ssize_t *result)
+{
+    struct ksu_devon_rc_view *view;
+    size_t wanted, copied;
+    int ret;
+
+    if (!*count)
+        return 0;
+    ret = ksu_devon_rc_get(file, i_size_read(file_inode(file)), &view);
+    if (ret || !view)
+        return ret;
+    if (*pos < 0)
+        return -EINVAL;
+    if (*pos < view->base) {
+        *count = min_t(size_t, *count, view->base - *pos);
+        return 0;
+    }
+    if (*pos >= view->total) {
+        *result = 0;
+        return 1;
+    }
+    wanted = min_t(size_t, *count, view->total - *pos);
+    copied = wanted - copy_to_user(buf, view->tail + (*pos - view->base), wanted);
+    *pos += copied;
+    *result = copied ? copied : -EFAULT;
+    return 1;
+}
+
+int ksu_handle_initrc_iter_file(struct file *file, struct iov_iter *iter,
+                                loff_t *pos, size_t *limit, bool synchronous,
+                                ssize_t *result)
+{
+    struct ksu_devon_rc_view *view;
+    size_t copied;
+    int ret;
+
+    if (!*limit || !ksu_devon_rc_owner(file))
+        return 0;
+    /* This staged overlay supports synchronous init reads only. */
+    if (!synchronous) {
+        bool captured;
+
+        mutex_lock(&ksu_devon_rc_lock);
+        captured = ksu_devon_rc_find(file) != NULL;
+        mutex_unlock(&ksu_devon_rc_lock);
+        return captured || (!ksu_init_rc_hook_inactive() && is_init_rc(file)) ? -EOPNOTSUPP : 0;
+    }
+    ret = ksu_devon_rc_get(file, i_size_read(file_inode(file)), &view);
+    if (ret || !view)
+        return ret;
+    if (*pos < 0)
+        return -EINVAL;
+    if (*pos < view->base) {
+        *limit = min_t(size_t, *limit, view->base - *pos);
+        return 0;
+    }
+    if (*pos >= view->total) {
+        *result = 0;
+        return 1;
+    }
+    copied = copy_to_iter(view->tail + (*pos - view->base),
+                          min_t(size_t, *limit, view->total - *pos), iter);
+    *pos += copied;
+    *result = copied ? copied : -EFAULT;
+    return 1;
+}
+
+ssize_t ksu_handle_initrc_read_result(struct file *file, loff_t before, ssize_t result)
+{
+    struct ksu_devon_rc_view *view;
+
+    if (result || !ksu_devon_rc_owner(file))
+        return result;
+    mutex_lock(&ksu_devon_rc_lock);
+    view = ksu_devon_rc_find(file);
+    if (view && before >= 0 && before < view->base)
+        result = -EIO; /* Do not report logical EOF before the captured prefix. */
+    mutex_unlock(&ksu_devon_rc_lock);
+    return result;
+}
+
+int ksu_handle_initrc_seek_file(struct file *file, loff_t offset, int whence,
+                                loff_t *result)
+{
+    struct ksu_devon_rc_view *view;
+    int ret;
+
+    if (whence != SEEK_END && whence != SEEK_DATA && whence != SEEK_HOLE)
+        return 0;
+    ret = ksu_devon_rc_get(file, i_size_read(file_inode(file)), &view);
+    if (ret || !view)
+        return ret;
+    if (whence != SEEK_END)
+        return -EOPNOTSUPP;
+    if (offset > LLONG_MAX - view->total)
+        return -EOVERFLOW;
+    *result = generic_file_llseek_size(file, offset, whence,
+                                      file_inode(file)->i_sb->s_maxbytes, view->total);
+    return 1;
+}
+
+void ksu_handle_initrc_file_release(struct file *file)
+{
+    struct ksu_devon_rc_view *view;
+
+    /* __fput has no remaining file users; remove state before object reuse. */
+    mutex_lock(&ksu_devon_rc_lock);
+    view = ksu_devon_rc_find(file);
+    if (view) {
+        list_del(&view->node);
+        kfree(view);
+    }
+    mutex_unlock(&ksu_devon_rc_lock);
+}
+#else
 static ssize_t (*orig_read)(struct file *, char __user *, size_t, loff_t *);
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(3, 16, 0) || defined(KSU_HAS_FOP_READ_ITER)

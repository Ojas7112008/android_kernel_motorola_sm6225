+    count = db->p_types.nprim;
+    if (count >= INT_MAX || !db->type_attr_map_array ||
+        !db->type_val_to_struct_array || !db->sym_val_to_name[SYM_TYPES] ||
+        (db->p_roles.nprim && !db->role_val_to_struct))
+        return false;
+    old_maps = db->type_attr_map_array;
+    old_types = db->type_val_to_struct_array;
+    old_names = db->sym_val_to_name[SYM_TYPES];
+    if (old_maps->element_size != sizeof(struct ebitmap) ||
+        old_types->element_size != sizeof(struct type_datum *) ||
+        old_names->element_size != sizeof(char *) ||
+        old_maps->total_nr_elements < 0 || old_types->total_nr_elements < 0 ||
+        old_names->total_nr_elements < 0 ||
+        count > (u32)old_maps->total_nr_elements ||
+        count > (u32)old_types->total_nr_elements ||
+        count > (u32)old_names->total_nr_elements)
+        return false;
+    value = count + 1;
+
+    type = kzalloc(sizeof(*type), GFP_KERNEL);
+    if (!type)
+        goto out;
+    type->primary = 1;
+    type->value = value;
+    type->attribute = attr;
+    key = kstrdup(type_name, GFP_KERNEL);
+    if (!key)
+        goto out;
+
+    maps = flex_array_alloc(sizeof(struct ebitmap), value, GFP_KERNEL | __GFP_ZERO);
+    if (!maps)
+        goto out;
+    types = flex_array_alloc(sizeof(struct type_datum *), value, GFP_KERNEL | __GFP_ZERO);
+    if (!types)
+        goto out;
+    names = flex_array_alloc(sizeof(char *), value, GFP_KERNEL | __GFP_ZERO);
+    if (!names)
+        goto out;
+    if (flex_array_prealloc(maps, 0, value, GFP_KERNEL | __GFP_ZERO) ||
+        flex_array_prealloc(types, 0, value, GFP_KERNEL | __GFP_ZERO) ||
+        flex_array_prealloc(names, 0, value, GFP_KERNEL | __GFP_ZERO))
+        goto out;
+
+    /* Copy logical entries, not spare capacity. Old bitmap nodes are borrowed. */
+    for (i = 0; i < count; i++) {
+        old_map = flex_array_get(old_maps, i);
+        old_type = flex_array_get_ptr(old_types, i);
+        old_name = flex_array_get_ptr(old_names, i);
+        if (!old_type || !old_name ||
+            (old_map && flex_array_put(maps, i, old_map, GFP_KERNEL)) ||
+            flex_array_put_ptr(types, i, old_type, GFP_KERNEL) ||
+            flex_array_put_ptr(names, i, old_name, GFP_KERNEL))
+            goto out;
+    }
+    if (ebitmap_set_bit(&self, count, 1) ||
+        flex_array_put(maps, count, &self, GFP_KERNEL) ||
+        flex_array_put_ptr(types, count, type, GFP_KERNEL) ||
+        flex_array_put_ptr(names, count, key, GFP_KERNEL))
+        goto out;
+
+    if (db->p_roles.nprim) {
+        roles = kcalloc(db->p_roles.nprim, sizeof(*roles), GFP_KERNEL);
+        if (!roles)
+            goto out;
+        for (i = 0; i < db->p_roles.nprim; i++) {
+            if (!db->role_val_to_struct[i] ||
+                ebitmap_cpy(&roles[i], &db->role_val_to_struct[i]->types) ||
+                ebitmap_set_bit(&roles[i], count, 1))
+                goto out;
+        }
+    }
+    /* Last fallible operation. On success the hash owns key and type. */
+    if (symtab_insert(&db->p_types, key, type))
+        goto out;
+
+    db->type_attr_map_array = maps;
+    db->type_val_to_struct_array = types;
+    db->sym_val_to_name[SYM_TYPES] = names;
+    db->p_types.nprim = value;
+    for (i = 0; i < db->p_roles.nprim; i++) {
+        ebitmap_destroy(&db->role_val_to_struct[i]->types);
+        db->role_val_to_struct[i]->types = roles[i];
+    }
+    kfree(roles); /* Role bitmap nodes have transferred to the policy. */
+    flex_array_free(old_maps); /* Borrowed map nodes now belong to maps. */
+    flex_array_free(old_types);
+    flex_array_free(old_names);
+    return true;
+
+out:
+    if (roles) {
+        for (i = 0; i < db->p_roles.nprim; i++)
+            ebitmap_destroy(&roles[i]);
+    }
+    kfree(roles);
+    ebitmap_destroy(&self);
+    /* Free only containers: copied old bitmap nodes still belong to the policy. */
+    if (maps)
+        flex_array_free(maps);
+    if (types)
+        flex_array_free(types);
+    if (names)
+        flex_array_free(names);
+    kfree(key);
+    kfree(type);
+    return false;
+}

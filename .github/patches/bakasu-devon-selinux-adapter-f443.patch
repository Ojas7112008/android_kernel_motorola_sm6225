+#ifdef KSU_COMPAT_SUSFS_DEVON_SELINUX_ADAPTER
+/* Readers, feature toggles, publication and destruction share this mutex. */
+void ksu_selinux_hide_lock(void)
+{
+    mutex_lock(&selinux_hide_mutex);
+}
+
+void ksu_selinux_hide_unlock(void)
+{
+    mutex_unlock(&selinux_hide_mutex);
+}
+
+static bool ksu_susfs_lock_policy(void)
+{
+    if (ksu_get_uid_t(current_uid()) < 10000)
+        return false;
+
+    mutex_lock(&selinux_hide_mutex);
+    if (!ksu_selinux_hide_running) {
+        mutex_unlock(&selinux_hide_mutex);
+        return false;
+    }
+    return true;
+}
+
+static bool ksu_susfs_policy_ready(void)
+{
+    return backup_policydb && backup_sidtab && selinux_state.ss;
+}
+
+static int ksu_susfs_saved_context_to_sid(const char *context, u32 len,
+                                         u32 *saved_sid, u32 *live_sid, int *live_error)
+{
+    /* The paired parser selects the live policy/table after taking its lock. */
+    return ksu_security_context_to_sid(NULL, NULL, backup_policydb, backup_sidtab,
+                                      context, len, saved_sid, SECSID_NULL,
+                                      GFP_KERNEL, live_sid, live_error);
+}
+
+bool ksu_susfs_set_current_sid(const char *context, u32 len, u32 *sid, int *error)
+{
+    u32 saved_sid, live_sid = SECSID_NULL;
+    int live_error = -EINVAL;
+
+    if (!ksu_susfs_lock_policy())
+        return false;
+
+    *sid = SECSID_NULL;
+    *error = -EAGAIN;
+    if (ksu_susfs_policy_ready()) {
+        *error = ksu_susfs_saved_context_to_sid(context, len, &saved_sid,
+                                               &live_sid, &live_error);
+        if (!*error)
+            *error = live_error;
+        if (!*error)
+            *sid = live_sid;
+    }
+    mutex_unlock(&selinux_hide_mutex);
+    return true;
+}
+
+bool ksu_susfs_context_to_string(const char *context, u32 len, char **canon,
+                                u32 *canon_len, int *error)
+{
+    u32 saved_sid;
+
+    if (!ksu_susfs_lock_policy())
+        return false;
+
+    *canon = NULL;
+    *canon_len = 0;
+    *error = -EAGAIN;
+    if (!ksu_susfs_policy_ready())
+        goto out;
+
+    *error = ksu_susfs_saved_context_to_sid(context, len, &saved_sid, NULL, NULL);
+    if (*error)
+        goto out;
+    *error = ksu_security_sid_to_context(backup_policydb, backup_sidtab,
+                                        saved_sid, canon, canon_len);
+    if (*error) {
+        kfree(*canon);
+        *canon = NULL;
+        *canon_len = 0;
+    }
+out:
+    mutex_unlock(&selinux_hide_mutex);
+    return true;
+}
+
+bool ksu_susfs_compute_av(const char *source, const char *target, u16 tclass,
+                         struct av_decision *avd, int *error)
+{
+    u32 ssid, tsid;
+
+    if (!ksu_susfs_lock_policy())
+        return false;
+
+    memset(avd, 0, sizeof(*avd));
+    *error = -EAGAIN;
+    if (!ksu_susfs_policy_ready())
+        goto out;
+
+    *error = ksu_susfs_saved_context_to_sid(source, strlen(source), &ssid, NULL, NULL);
+    if (*error)
+        goto out;
+    *error = ksu_susfs_saved_context_to_sid(target, strlen(target), &tsid, NULL, NULL);
+    if (*error)
+        goto out;
+    ksu_security_compute_av_user(backup_policydb, backup_sidtab, ssid, tsid, tclass, avd);
+out:
+    mutex_unlock(&selinux_hide_mutex);
+    return true;
+}
+
+struct page *ksu_susfs_get_status_page(void)
+{
+    struct page *page = NULL;
+
+    /* The caller has already created the real status page. */
+#ifdef KSU_COMPAT_USE_STATIC_KEY
+    if (static_branch_unlikely(&fake_status_initialize_key))
+#else
+    if (!fake_status_initialize_key)
+#endif
+        initialize_fake_status();
+
+    if (!ksu_susfs_lock_policy())
+        return NULL;
+
+    if (selinux_state.ss) {
+        mutex_lock(&selinux_state.ss->status_lock);
+        if (fake_status) {
+            get_page(fake_status);
+            page = fake_status;
+        }
+        mutex_unlock(&selinux_state.ss->status_lock);
+    }
+    mutex_unlock(&selinux_hide_mutex);
+    return page;
+}
+#endif /* KSU_COMPAT_SUSFS_DEVON_SELINUX_ADAPTER */
